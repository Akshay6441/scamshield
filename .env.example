# Nebius Token Factory API Key (Required for Nemotron inference)
# Get your key at https://studio.nebius.ai/ or via Nebius Builder Program
NEBIUS_API_KEY=your_nebius_api_key_here
NEBIUS_BASE_URL=https://api.studio.nebius.com/v1/

# Model Routing Configuration:
# Nemotron Ultra: In-depth cognitive reasoning & psychological deconstruction
# Supported Token Factory IDs:
#   - nvidia/Llama-3.1-Nemotron-70B-Instruct-HF (Standard high-precision reasoning)
#   - nvidia/Nemotron-3-Ultra-550b-a55b (MoE reasoning flagship)
NEMOTRON_ULTRA=nvidia/Llama-3.1-Nemotron-70B-Instruct-HF

# Nemotron Nano / Super: High-speed judicial synthesis & defensive action planning
# Supported Token Factory IDs:
#   - nvidia/llama-3.1-nemotron-nano-8b-v1 (Low-latency everyday calls)
#   - nvidia/nemotron-3-super-120b-a12b (MoE synthesis)
#   - nvidia/Nemotron-3_5-Lightning
NEMOTRON_NANO=nvidia/llama-3.1-nemotron-nano-8b-v1

# Tavily Search API Key (Required for live threat intelligence & fraud lookup)
# Get your key at https://tavily.com (Included in Nebius Builder Program)
TAVILY_API_KEY=your_tavily_api_key_here

# Server Configuration
HOST=0.0.0.0
PORT=8000
